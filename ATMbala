
public class ATM {
    static String name= "Akshay";
    static int balance= 10000;
    static int pin= 1234;

    public static void greet() {
        System.out.println("Welcome to the ATM, " + name + "!");
    }

    public static void checkpin(int enteredPin) {
        if (enteredPin == pin) {
            System.out.println("PIN is correct. Access granted.");
        } else {
            System.out.println("Incorrect PIN. Access denied.");
        }
    }

    public static void deposit(int amount){
        balance = balance + amount;
        System.out.println("Deposit successful. New balance: " + balance);

    }

    public static void withdraw(int amount){
       balance = balance - amount;
        System.out.println("Withdrawl successful. new balance: " + balance);
    }

    public static void setNewPin(int newPin){
        pin = newPin;
        System.out.println("PIN changed successfully." + "New PIN: " + pin);
    }




    public static void main(String[] args) {
        greet();
        checkpin(1234);
        deposit(5000);
        withdraw(2000);
        setNewPin(7890);
        checkpin(1234);
        deposit(6000);
        withdraw(4000);
    }





}

 